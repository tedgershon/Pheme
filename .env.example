# Google Cloud OAuth web application credentials (local Supabase only).
# Copy to .env, fill in values, then enable [auth.external.google] in config.toml.
# Authorized Google redirect: http://127.0.0.1:45321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
